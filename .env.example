STEAM_COOKIE_FILE_PATH=your/path/to/cookies.json
# I used a Supabase database for this project. If using a different database, change the DATABASE_URL/DATABASE env variables
# as needed. The format for DATABASE_URL is: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://username:password@host:port/database
# Review scraping options
REVIEW_FILTER=recent
REVIEW_MAX_REVIEWS=10
REVIEW_LANGUAGE=english
# Steam base URL
# Exists for testing purposes, but should not be changed unless you know what you're doing.
STEAM_BASE_URL=https://store.steampowered.com
# IsThereAnyDeal API key. You can get one at https://itad.github.io/itad-api-docs/#authentication
ITAD_API_KEY=your-itad-api-key
# --- Auth / sessions ---
# Keys for encrypting (AES-256) + signing (HMAC-SHA256) the session cookie. Generate with:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(64)).decode())"   (hash key, 64 bytes)
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"   (block key, exactly 32 bytes)
SESSION_HASH_KEY=
SESSION_BLOCK_KEY=
# Set to true when serving over HTTPS.
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:8080
# Redis (e.g. Upstash): rediss://default:<password>@<host>.upstash.io:6379
REDIS_URL=
# Steam Web API key from https://steamcommunity.com/dev/apikey (used for profile cards)
STEAM_WEB_API_KEY=

# --- Operations (see docs/OPERATIONS.md, docs/CI-CD.md) ---
# If set, GET /metrics requires "Authorization: Bearer <this value>".
METRICS_TOKEN=
# Set to true when a cron job / systemd timer / scheduled task runs the scraper (deploy/),
# so the API process doesn't also scrape on its own timer.
DISABLE_SCHEDULER=false
# Tests only: a Postgres that backend integration tests may create temporary schemas in.
# They never touch the public schema. Unset = those tests are skipped.
TEST_DATABASE_URL=
